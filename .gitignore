# Rust
/target/
**/target/
Cargo.lock.bak

# Qt / C++ build
/build/
**/build/
*.user
*.o
*.obj
moc_*.cpp
qrc_*.cpp
ui_*.h
CMakeCache.txt
CMakeFiles/

# Vendored engine build artifacts (keep source refs, ignore outputs)
/third_party/**/out/

# Provisioned engine binaries. SDS §13.4 fetches these with a setup step, so
# only third_party/pdfium/provenance.toml is committed. [ADR-028 §3]
/third_party/pdfium/prebuilt/

# Node (Claude Code / tooling)
node_modules/

# Python (tools/ gate scripts leave bytecode caches)
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Agent session state (ephemeral, not committed)
.agent-state/
.claude/settings.local.json
.swarm/
.serena/cache/
# Local vector/index caches — may contain indexed source; never commit (GIT-5)
ruvector.db
.codebase-memory/

# Secrets - never commit
*.pem
*.key
.env
*.local
